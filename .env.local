# AERO.IST Mail Platform — copy these into Render Environment settings.
NODE_ENV=production
PORT=10000
APP_URL=https://mail.aero.ist

# Supabase Project URL + Settings > API Keys
SUPABASE_URL=https://xakjhabanfrauajzdfib.supabase.co

SUPABASE_PUBLISHABLE_KEY=sb_publishable_wShiqZ82RCgvNABKoBFCOw_Bym0UaQZ
SUPABASE_SECRET_KEY=
# Legacy alternatives are also supported: SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY

# Resend > API Keys and Domains
RESEND_API_KEY=re_your_real_api_key
RESEND_WEBHOOK_SECRET=whsec_your_real_webhook_signing_secret

# The app itself can run at mail.aero.ist. Use a separate mailbox subdomain
# initially so you do not take over any existing MX records for aero.ist.
MAILBOX_DOMAIN=inbox.aero.ist
MAX_MAILBOXES_PER_USER=3
MAX_ATTACHMENT_MB=20
